<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HomeGym — тренажерний зал у Хмельницькому</title>
<meta name="description" content="HomeGym: персональні тренування з фітнесу та бодібілдингу, консультації з харчування. Пн–Сб 11:00–22:00.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--p1:url('data:image/jpeg;base64,');--p2:url('data:image/jpeg;base64,');--p3:url('data:image/jpeg;base64,');--p4:url('data:image/jpeg;base64,');--p5:url('data:image/jpeg;base64,');
  --y:#FBCE03; --y-dark:#C9A400; --ink:#22200F; --paper:#FFFFFF; --soft:#FFF8D6; --mute:#6B6850;
  --display:'Anton','Impact','Arial Narrow',sans-serif;
  --body:'Manrope','Segoe UI',Arial,sans-serif;
  /* Свої фото: покладіть файли в папку img/ з такими назвами */
  --photo-hero:var(--p1);
  --photo-quote:var(--p3);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--ink);background:var(--paper);line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--display);font-weight:400;line-height:1;letter-spacing:.01em;text-transform:uppercase}

/* nav */
header{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:3px solid var(--y)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:var(--display);font-size:28px;text-decoration:none;letter-spacing:.03em}
.logo span{background:var(--y);padding:0 6px;margin-left:2px}
.nav ul{display:flex;gap:24px;list-style:none;font-weight:600;font-size:15px}
.nav ul a{text-decoration:none}
.nav ul a:hover{text-decoration:underline;text-decoration-color:var(--y);text-decoration-thickness:3px;text-underline-offset:6px}
.btn{display:inline-block;background:var(--ink);color:var(--y);font-weight:800;text-decoration:none;padding:15px 28px;border-radius:4px;transition:transform .15s, background .15s}
.btn:hover{transform:translateY(-2px);background:#000}
.btn.yellow{background:var(--y);color:var(--ink)}
.btn.yellow:hover{background:#ffd930}
.btn.line{background:transparent;color:var(--ink);border:3px solid var(--ink)}
.btn.line:hover{background:var(--ink);color:var(--y)}

/* hero */
.hero{position:relative;background:linear-gradient(115deg,var(--y) 0 58%,#fff 58% 100%);overflow:hidden}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.25fr .75fr;gap:40px;align-items:center;min-height:620px;padding-top:56px;padding-bottom:56px}
.hero h1{font-size:clamp(52px,9vw,112px);line-height:.92}
.hero h1 em{font-style:normal;display:block;margin-top:.16em;padding-left:.55em;-webkit-text-stroke:3px var(--ink);color:transparent}
.hero p.lead{font-size:20px;font-weight:600;max-width:30ch;margin:24px 0 32px}
.hero .cta{display:flex;gap:14px;flex-wrap:wrap}
.hours-card{background:var(--ink);color:#fff;padding:28px;border-radius:6px;box-shadow:10px 10px 0 var(--paper);outline:3px solid var(--ink)}
.hours-card h3{color:var(--y);font-size:26px;margin-bottom:16px}
.hours-card dl{display:grid;grid-template-columns:auto 1fr;gap:10px 18px;font-size:17px}
.hours-card dt{color:#cfcab0}
.hours-card dd{font-weight:800;text-align:right}
.hours-card .off{color:var(--y)}

/* ticker */
.ticker{background:var(--ink);color:var(--y);overflow:hidden;white-space:nowrap;padding:14px 0;font-family:var(--display);font-size:26px;letter-spacing:.04em}
.ticker div{display:inline-block;padding-left:100%;animation:run 28s linear infinite}
@keyframes run{to{transform:translateX(-100%)}}

section{padding:88px 0}
.sec-title{font-size:clamp(40px,6vw,72px);margin-bottom:12px}
.sec-sub{color:var(--mute);font-size:18px;max-width:52ch;margin-bottom:48px}

/* services */
.services{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.service{border:3px solid var(--ink);padding:32px 28px;border-radius:6px;background:var(--paper)}
.service:nth-child(1){background:var(--y)}
.service h3{font-size:30px;margin-bottom:12px}
.service p{font-size:16px}

/* gallery */
.gallery{display:grid;grid-template-columns:2fr 1fr 1fr;grid-auto-rows:240px;gap:12px}
.tile{background:linear-gradient(135deg,#3a3720,#22200F);background-size:cover;background-position:center;border-radius:6px;position:relative;display:flex;align-items:flex-end;padding:18px;color:var(--y);font-family:var(--display);font-size:24px;text-transform:uppercase}
.tile:first-child{grid-row:span 2}
.t1{background-image:var(--p1)}.t2{background-image:var(--p2);background-position:center 30%}.t3{background-image:var(--p3)}.t4{background-image:var(--p4);background-position:center 35%}
.tile::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(34,32,15,.75),transparent 60%);border-radius:6px}
.tile span{position:relative;z-index:1}

/* quote */
.quote{background:var(--ink) var(--photo-quote) center/cover no-repeat;background-blend-mode:multiply;color:#fff;text-align:center;padding:120px 0}
.quote blockquote{font-family:var(--display);text-transform:uppercase;font-size:clamp(36px,6.5vw,84px);line-height:1.02;max-width:16ch;margin:0 auto}
.quote blockquote b{font-weight:400;color:var(--y)}
.quote .more{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:72px;text-align:left}
.quote .more p{border-left:5px solid var(--y);padding-left:18px;font-size:19px;font-weight:600}

/* pricing */
.pricing{background:var(--soft)}
.prices{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.price{background:var(--paper);border:3px solid var(--ink);border-radius:6px;padding:28px;display:flex;flex-direction:column;gap:6px}
.price h3{font-size:26px}
.price .sub{color:var(--mute);font-size:15px;min-height:24px}
.price .sum{font-family:var(--display);font-size:64px;line-height:1;margin:14px 0 4px}
.price .sum small{font-family:var(--body);font-size:20px;font-weight:800}
.price .per{font-size:14px;color:var(--mute);margin-bottom:18px}
.price .btn{margin-top:auto;text-align:center}
.price.hit{background:var(--y);transform:scale(1.03);box-shadow:10px 10px 0 var(--ink)}
.price.hit .sub,.price.hit .per{color:var(--ink)}
.badge{align-self:flex-start;background:var(--ink);color:var(--y);font-weight:800;font-size:13px;padding:4px 10px;border-radius:3px}
.note{margin-top:28px;font-weight:600}

/* cta */
.final{background:var(--y);text-align:center}
.final h2{font-size:clamp(44px,8vw,104px);max-width:14ch;margin:0 auto 28px}
.final p{font-size:19px;font-weight:600;margin-bottom:32px}
footer{background:var(--ink);color:#cfcab0;padding:32px 0;font-size:15px}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer a{color:var(--y)}

@media (max-width:860px){
  .nav ul{display:none}
  .hero{background:var(--y)}
  .hero .wrap{grid-template-columns:1fr;min-height:0}
  .services,.prices,.quote .more{grid-template-columns:1fr}
  .gallery{grid-template-columns:1fr 1fr;grid-auto-rows:180px}
  .tile:first-child{grid-column:span 2;grid-row:auto}
  .price.hit{transform:none}
  section{padding:64px 0}
}
@media (prefers-reduced-motion:reduce){.ticker div{animation:none;padding-left:0}html{scroll-behavior:auto}}

dialog{border:3px solid var(--ink);border-radius:8px;padding:0;width:min(460px,calc(100vw - 32px));max-height:calc(100vh - 32px);overflow:auto;box-shadow:12px 12px 0 var(--y);background:var(--paper);color:var(--ink);margin:auto}
dialog::backdrop{background:rgba(34,32,15,.72)}
dialog[open]{animation:pop .22s ease-out}
@keyframes pop{from{transform:translateY(14px);opacity:0}to{transform:none;opacity:1}}
.modal-head{background:var(--y);padding:24px 56px 20px 28px;border-bottom:3px solid var(--ink);position:relative}
.modal-head h2{font-size:40px}
.modal-head p{font-weight:600;margin-top:6px}
.x{position:absolute;top:14px;right:14px;width:40px;height:40px;border:3px solid var(--ink);background:var(--paper);border-radius:4px;font-size:22px;font-weight:800;cursor:pointer;line-height:1}
.x:hover{background:var(--ink);color:var(--y)}
.modal form{padding:24px 28px 28px;display:grid;gap:16px}
.modal label{display:grid;gap:6px;font-weight:800;font-size:15px}
.modal input,.modal select,.modal textarea{font:inherit;font-weight:600;padding:13px 14px;border:3px solid var(--ink);border-radius:4px;background:var(--paper);color:var(--ink);width:100%}
.modal input:focus,.modal select:focus,.modal textarea:focus{outline:none;background:var(--soft);box-shadow:0 0 0 3px var(--y)}
.modal textarea{min-height:84px;resize:vertical}
.modal .btn{border:0;cursor:pointer;font-family:inherit;font-size:17px}
.modal .hp{position:absolute;left:-9999px}
.msg{padding:0 28px 28px;font-weight:600}
.msg[hidden],.modal form[hidden]{display:none}
.thanks{padding:40px 28px;text-align:center}
.thanks h3{font-size:44px;margin-bottom:10px}
.thanks p{margin-bottom:22px;font-weight:600}
.err{color:#9a1b00;font-weight:800;font-size:15px}
</style>
</head>
<body>

<header>
  <div class="wrap nav">
    <a class="logo" href="#top">HOME<span>GYM</span></a>
    <ul>
      <li><a href="#services">Послуги</a></li>
      <li><a href="#gallery">Зал</a></li>
      <li><a href="#pricing">Ціни</a></li>
      <li><a href="#contact">Контакти</a></li>
    </ul>
    <a class="btn yellow js-open" href="#join" data-plan="">Записатись</a>
  </div>
</header>

<main id="top">
  <div class="hero">
    <div class="wrap">
      <div>
        <h1>Твоє тіло<em>твій проєкт</em></h1>
        <p class="lead">Зал для тих, хто прийшов працювати, а не просто бути присутнім.</p>
        <div class="cta">
          <a class="btn" href="#pricing">Дивитись ціни</a>
          <a class="btn line" href="https://www.instagram.com/homegym.khm/" target="_blank" rel="noopener">Написати в Instagram</a>
        </div>
      </div>
      <aside class="hours-card" aria-label="Графік роботи">
        <h3>Графік роботи</h3>
        <dl>
          <dt>Понеділок – Субота</dt><dd>11:00 – 22:00</dd>
          <dt>Неділя</dt><dd class="off">Вихідний</dd>
        </dl>
      </aside>
    </div>
  </div>

  <div class="ticker" aria-hidden="true"><div>БЕЗ ВІДМОВОК &nbsp;•&nbsp; ЩОДНЯ ТРОХИ СИЛЬНІШИЙ &nbsp;•&nbsp; ПРАЦЮЙ НАД СОБОЮ &nbsp;•&nbsp; БЕЗ ВІДМОВОК &nbsp;•&nbsp; ЩОДНЯ ТРОХИ СИЛЬНІШИЙ &nbsp;•&nbsp; ПРАЦЮЙ НАД СОБОЮ &nbsp;•&nbsp;</div></div>

  <section id="services">
    <div class="wrap">
      <h2 class="sec-title">Що ти отримаєш</h2>
      <p class="sec-sub">Тренуйся сам або з тренером. План, техніка і харчування працюють разом.</p>
      <div class="services">
        <article class="service">
          <h3>Персональні тренування</h3>
          <p>Фітнес і бодібілдинг. Тренер складає програму під твою ціль, ставить техніку і слідкує за прогресом.</p>
        </article>
        <article class="service">
          <h3>Консультації з харчування</h3>
          <p>Раціон під масу, схуднення або рельєф. Без дієт-марафонів, з простими продуктами.</p>
        </article>
        <article class="service">
          <h3>Зал для тренувань</h3>
          <p>Обладнання для силових і функціональних тренувань. Працюємо шість днів на тиждень до 22:00.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="gallery" style="padding-top:0">
    <div class="wrap">
      <div class="gallery">
        <div class="tile t1"><span>Сила починається тут</span></div>
        <div class="tile t2"><span>Техніка</span></div>
        <div class="tile t3"><span>Вага</span></div>
        <div class="tile t4"><span>Результат</span></div>
        <div class="tile t1" style="grid-column:span 2;background-image:var(--p5);background-position:center 8%"><span>Команда HomeGym</span></div>
      </div>
    </div>
  </section>

  <section class="quote">
    <div class="wrap">
      <blockquote>Мотивація приходить і йде. <b>Дисципліна</b> залишається.</blockquote>
      <div class="more">
        <p>Важкий перший місяць. Потім звичка. Потім ти не уявляєш життя без залу.</p>
        <p>Ніхто не робитиме твої повторення за тебе. Тому ставай і тисни.</p>
        <p>Через рік ти подякуєш собі за те, що почав сьогодні.</p>
      </div>
    </div>
  </section>

  <section id="pricing" class="pricing">
    <div class="wrap">
      <h2 class="sec-title">Прайс</h2>
      <p class="sec-sub">Обирай формат під свій графік. До 15:00 тренування дешевші.</p>
      <div class="prices">
        <article class="price">
          <h3>Разове тренування</h3>
          <p class="sub">Спробувати без зобов’язань</p>
          <p class="sum">80 <small>грн</small></p>
          <p class="per">за одне відвідування</p>
          <a class="btn js-open" href="#join" data-plan="Разове тренування">Прийти</a>
        </article>
        <article class="price hit">
          <span class="badge">Найвигідніше для щоденних</span>
          <h3>Безліміт</h3>
          <p class="sub">Місяць, скільки хочеш разів</p>
          <p class="sum">530 <small>грн</small></p>
          <p class="per">за місяць</p>
          <a class="btn js-open" href="#join" data-plan="Безліміт">Взяти безліміт</a>
        </article>
        <article class="price">
          <h3>12 тренувань</h3>
          <p class="sub">Пакет на місяць</p>
          <p class="sum">500 <small>грн</small></p>
          <p class="per">≈ 42 грн за тренування</p>
          <a class="btn js-open" href="#join" data-plan="12 тренувань">Обрати</a>
        </article>
        <article class="price">
          <h3>8 тренувань</h3>
          <p class="sub">Для початку</p>
          <p class="sum">450 <small>грн</small></p>
          <p class="per">≈ 56 грн за тренування</p>
          <a class="btn js-open" href="#join" data-plan="8 тренувань">Обрати</a>
        </article>
        <article class="price">
          <h3>12 тренувань до 15:00</h3>
          <p class="sub">Ранкові й денні години</p>
          <p class="sum">470 <small>грн</small></p>
          <p class="per">≈ 39 грн за тренування</p>
          <a class="btn js-open" href="#join" data-plan="12 тренувань до 15:00">Обрати</a>
        </article>
        <article class="price">
          <h3>8 тренувань до 15:00</h3>
          <p class="sub">Ранкові й денні години</p>
          <p class="sum">420 <small>грн</small></p>
          <p class="per">≈ 53 грн за тренування</p>
          <a class="btn js-open" href="#join" data-plan="8 тренувань до 15:00">Обрати</a>
        </article>
      </div>
      <p class="note">Персональні тренування та консультації з харчування: ціну уточнюйте в Instagram.</p>
    </div>
  </section>

  <section id="contact" class="final">
    <div class="wrap">
      <h2>Почни сьогодні</h2>
      <p>Залиш заявку, і ми передзвонимо та підберемо абонемент і час.</p>
      <a class="btn js-open" href="#join" data-plan="">Залишити заявку</a> <a class="btn line" href="https://www.instagram.com/homegym.khm/" target="_blank" rel="noopener">@homegym.khm</a>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <span>© HomeGym. Пн–Сб 11:00–22:00, Нд вихідний.</span>
    <a href="https://www.instagram.com/homegym.khm/" target="_blank" rel="noopener">Instagram</a>
  </div>
</footer>


<dialog id="join" class="modal" aria-labelledby="join-title">
  <div class="modal-head">
    <h2 id="join-title">Запис у зал</h2>
    <p>Залиш номер, ми зателефонуємо протягом дня.</p>
    <button class="x" type="button" aria-label="Закрити" data-close>×</button>
  </div>
  <form id="join-form" name="homegym-zayavka" method="POST" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="homegym-zayavka">
    <p class="hp"><label>Не заповнювати <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
    <label>Ім’я
      <input name="name" type="text" required autocomplete="given-name" placeholder="Як до тебе звертатись">
    </label>
    <label>Телефон
      <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" pattern="[0-9+()\-\s]{9,}" placeholder="+380 __ ___ __ __">
    </label>
    <label>Що цікавить
      <select name="plan" id="plan">
        <option value="Ще не визначився">Ще не визначився</option>
        <option>Разове тренування</option>
        <option>Безліміт</option>
        <option>12 тренувань</option>
        <option>8 тренувань</option>
        <option>12 тренувань до 15:00</option>
        <option>8 тренувань до 15:00</option>
        <option>Персональне тренування</option>
        <option>Консультація з харчування</option>
      </select>
    </label>
    <label>Коментар (необов’язково)
      <textarea name="comment" placeholder="Ціль, зручний час"></textarea>
    </label>
    <button class="btn yellow" type="submit">Відправити заявку</button>
    <p class="err" id="join-err" role="alert" hidden>Не вдалося відправити. Напишіть нам в <a href="https://www.instagram.com/homegym.khm/" target="_blank" rel="noopener">Instagram</a>.</p>
  </form>
  <div class="thanks" id="join-ok" hidden>
    <h3>Заявку прийнято</h3>
    <p>Ми зателефонуємо тобі найближчим часом. До зустрічі в залі.</p>
    <button class="btn" type="button" data-close>Закрити</button>
  </div>
</dialog>

<script>
(function(){
  var dlg=document.getElementById('join'),form=document.getElementById('join-form'),
      ok=document.getElementById('join-ok'),err=document.getElementById('join-err'),plan=document.getElementById('plan');
  function open(p){
    form.hidden=false;ok.hidden=true;err.hidden=true;
    if(p){for(var i=0;i<plan.options.length;i++){if(plan.options[i].value===p){plan.selectedIndex=i;break;}}}
    if(dlg.showModal){dlg.showModal();}else{dlg.setAttribute('open','');}
  }
  document.querySelectorAll('.js-open').forEach(function(a){
    a.addEventListener('click',function(e){e.preventDefault();open(a.getAttribute('data-plan'));});
  });
  dlg.querySelectorAll('[data-close]').forEach(function(b){b.addEventListener('click',function(){dlg.close();});});
  dlg.addEventListener('click',function(e){if(e.target===dlg){dlg.close();}});
  form.addEventListener('submit',function(e){
    e.preventDefault();err.hidden=true;
    var done=function(){form.hidden=true;ok.hidden=false;form.reset();};
    if(location.protocol==='file:'){done();return;} /* демо-режим при відкритті файлом */
    fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body:new URLSearchParams(new FormData(form)).toString()})
      .then(function(r){if(!r.ok){throw new Error();}done();})
      .catch(function(){err.hidden=false;});
  });
})();
</script>
</body>
</html>
